<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.alktrip</groupId>
    <artifactId>cfdi4j-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>cfdi4j-xml</artifactId>
  <name>cfdi4j XML</name>
  <description>CFDI 4.0 XML serialization, parsing, XSD validation and cadena original.</description>

  <properties>
    <coverage.minimum>0.90</coverage.minimum>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.alktrip</groupId>
      <artifactId>cfdi4j-core</artifactId>
    </dependency>
    <!-- XSLT 2.0 processor for the official cadena original stylesheet (the JDK only has XSLT 1.0). -->
    <dependency>
      <groupId>net.sf.saxon</groupId>
      <artifactId>Saxon-HE</artifactId>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- Official SAT XSD/XSLT, bundled unmodified (ADR 0007). -->
      <resource>
        <directory>${project.basedir}/../specs/sat/xml</directory>
        <targetPath>sat/xml</targetPath>
      </resource>
    </resources>
  </build>
</project>
